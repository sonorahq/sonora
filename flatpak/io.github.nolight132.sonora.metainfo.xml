<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nolight132.sonora</id>

  <name>Sonora</name>
  <developer id="io.github.nolight132">
    <name>nolight132</name>
  </developer>
  <keywords>
    <keyword>music</keyword>
    <keyword>spotify</keyword>
    <keyword>audio</keyword>
    <keyword>player</keyword>
  </keywords>
  <summary>A native music streaming client, built with Rust and GPUI</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/sonorahq/sonora</url>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <description>
    <p>
      Sonora streams Spotify and YouTube Music and plays your local files from one native
      desktop app built with Rust and GPUI, with lyrics, artist pages, playlists, and
      system media controls.
    </p>
  </description>

  <content_rating type="oars-1.1" />

